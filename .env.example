# ─────────────────────────── Telegram ───────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Твой Telegram user id (и другие админы через запятую).
# Узнать свой id: написать @userinfobot или запустить бота и посмотреть /id
TELEGRAM_ADMIN_IDS=123456789

# ───────────────────────────── OpenAI ────────────────────────────
# Ключ нужен для анализа видео и генерации комментариев
OPENAI_API_KEY=sk-...

# Модель и адрес API (можно указать прокси-совместимый endpoint)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Тема, по которой ищем релевантные видео
TARGET_TOPIC=job search, careers, remote work, productivity

# ────────────────────────────── Chrome ───────────────────────────
# Chrome должен быть запущен с --remote-debugging-port=9222 и залогинен в TikTok
CHROME_ENDPOINT=http://127.0.0.1:9222
# Альтернатива: полный websocket endpoint
# CHROME_WS_ENDPOINT=ws://127.0.0.1:9222/devtools/browser/xxxx

# ────────────────────────────── Бот ──────────────────────────────
# Значения ниже — дефолты. Любое можно поменять прямо в Telegram: /settings, /set
MIN_RELEVANCE_SCORE=0.7        # 0..1, порог релевантности видео
COMMENT_DELAY_SECONDS=30       # пауза после успешного комментария
MAX_COMMENTS_PER_HOUR=20       # лимит комментариев в час
VIDEO_DELAY_MIN=3              # пауза перед следующим видео, сек
VIDEO_DELAY_MAX=8
SESSION_MAX_MINUTES=120        # автостоп сессии
MAX_COMMENTS_PER_RUN=200

# Ручное подтверждение каждого комментария (рекомендуется)
APPROVAL_MODE=true
APPROVAL_TIMEOUT_SECONDS=300   # сколько ждать кнопку «Отправить»

# Язык комментариев: ru | en | es | de | fr | pt | it
COMMENT_LANGUAGE=ru

# ───────────────────────────── Прочее ────────────────────────────
DB_PATH=./data/bot.db
LOG_LEVEL=info                 # error | warn | info | debug
STATUS_UPDATE_SECONDS=15       # как часто редактировать «живой» статус
